@model TARge25Shop.Models.RealEstate.RealEstateDetailViewModel

@{
    ViewData["Title"] = "RealEstate details";
}

<div class="medium">
    <div class="page-title d-block">
        <h1>@Model.Location</h1>
        <p>Kinnisvara detailid</p>
    </div>

    <div class="card mb-4">
        <div>
            <dl class="details">
                <dt>ID</dt>
                <dd>@Model.Id</dd>

                <dt>Area (m²)</dt>
                <dd>@Model.Area</dd>

                <dt>Location</dt>
                <dd>@Model.Location</dd>

                <dt>Room Number</dt>
                <dd>@Model.RoomNumber</dd>

                <dt>Building Type</dt>
                <dd>@Model.BuildingType</dd>

                <dt>Created at</dt>
                <dd>@Model.CreatedAt</dd>

                <dt>Modified at</dt>
                <dd>@Model.ModifiedAt</dd>
                
                
            </dl>
            

        </div>
    </div>

    @if (Model.Images.Any())
    {
        <h5 class="mb-3">Pildid</h5>
        <div class="images">
            @foreach (var images in Model.Images)
            {
                <partial name="_Images" model="images" />
            }
        </div>
    }

    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-primary">
            Tagasi nimekirja
        </a>
    </div>
</div>
