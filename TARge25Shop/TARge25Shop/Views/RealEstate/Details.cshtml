@model TARge25Shop.Models.RealEstate.RealEstateDetailViewModel

@{
    ViewData["Title"] = "RealEstate details";
}

<div class="container mt-4">
    <h1>Real Estate details</h1>
    <hr />

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white">
            <h5 class="card-title mb-0">Details</h5>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3 fw-bold">ID:</dt>
                <dd class="col-sm-9 text-muted">@Model.Id</dd>

                <dt class="col-sm-3 fw-bold">Area (m²):</dt>
                <dd class="col-sm-9">@Model.Area</dd>

                <dt class="col-sm-3 fw-bold">Location:</dt>
                <dd class="col-sm-9">@Model.Location</dd>

                <dt class="col-sm-3 fw-bold">Room Number:</dt>
                <dd class="col-sm-9">@Model.RoomNumber</dd>

                <dt class="col-sm-3 fw-bold">Building Type:</dt>
                <dd class="col-sm-9">@Model.BuildingType</dd>

                <dt class="col-sm-3 fw-bold">Created at:</dt>
                <dd class="col-sm-9">@Model.CreatedAt</dd>

                <dt class="col-sm-3 fw-bold">Modified at:</dt>
                <dd class="col-sm-9">@Model.ModifiedAt</dd>
                
                
            </dl>
            @foreach (var images in Model.Images)
            {
                <partial name="_Images" model="images" />
            }
            

        </div>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-secondary">
            Back
        </a>
    </div>
</div>
