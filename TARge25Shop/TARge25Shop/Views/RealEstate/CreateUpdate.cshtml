@model TARge25Shop.Models.RealEstate.RealEstateCreateUpdateViewModel

<div class="medium">
    <div class="page-title d-block">
        <h1>@(Model.Id.HasValue ? "Update" : "Create")</h1>
        <p>@(Model.Id.HasValue ? "Muuda kinnisvara andmeid" : "Lisa uus kinnisvara")</p>
    </div>

<div class="card p-4">
<form asp-controller="RealEstate" asp-action="@(Model.Id.HasValue ? "Update" : "Create")" method="post" enctype="multipart/form-data">
    <input asp-for="Id" type="hidden" />
    <input asp-for="CreatedAt" type="hidden" />
    <input asp-for="ModifiedAt" type="hidden" />

    <div class="row mb-3">
        <label asp-for="Area" class="col-sm-3 col-form-label fw-bold">Area (m²)</label>
        <div class="col-sm-9">
            <input asp-for="Area" class="form-control" />
        </div>
    </div>

    <div class="row mb-3">
        <label asp-for="Location" class="col-sm-3 col-form-label fw-bold"></label>
        <div class="col-sm-9">
            <input asp-for="Location" class="form-control" />
        </div>
    </div>

    <div class="row mb-3">
        <label asp-for="RoomNumber" class="col-sm-3 col-form-label fw-bold">Room Number</label>
        <div class="col-sm-9">
            <input asp-for="RoomNumber" class="form-control" />
        </div>
    </div>

    <div class="row mb-3">
        <label asp-for="BuildingType" class="col-sm-3 col-form-label fw-bold">Building Type</label>
        <div class="col-sm-9">
            <input asp-for="BuildingType" class="form-control" />
        </div>
    </div>

    <div class="row mb-3">
        <label asp-for="Files" class="col-sm-3 col-form-label fw-bold"></label>
        <div class="col-sm-9">
            <input asp-for="Files" multiple type="file" class="form-control" />
        </div>
    </div>

    @if (Model.Image.Any())
    {
        <h5 class="mt-4 mb-3">Praegused pildid</h5>
        <div class="images">
            @foreach (var images in Model.Image)
            {
                <div>
                    <partial name="_Images" model="images" />
                    <button type="submit" form="remove-image-form-@images.ImageId" class="btn btn-sm btn-outline-danger w-100 mt-2">
                        Remove Image
                    </button>
                </div>
            }
        </div>
    }

    @if (Model.Id.HasValue)
    {
        <input type="submit" class="btn btn-primary" value="Update" />
    }
    else
    {
        <input type="submit" class="btn btn-primary" value="Create" />
    }

    <a asp-action="Index" asp-controller="realestate" class="btn btn-outline-secondary">Back to List</a>
</form>
</div>
</div>
@foreach (var images in Model.Image)
{
    <form id="remove-image-form-@images.ImageId" asp-action="RemoveImage" asp-controller="RealEstate" method="post" style="display:none;">
        <input type="hidden" name="ImageId" value="@images.ImageId" />
    </form>
}
