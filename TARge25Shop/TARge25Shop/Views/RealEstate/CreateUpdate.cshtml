@model TARge25Shop.Models.RealEstate.RealEstateCreateUpdateViewModel

@if (Model.Id.HasValue)
{
    <h1>Update</h1>
}
else
{
    <h1>Create</h1>
}

<form asp-controller="RealEstate" asp-action="@(Model.Id.HasValue ? "Update" : "Create")" method="post" enctype="multipart/form-data">
    <input asp-for="Id" type="hidden" />
    <input asp-for="CreatedAt" type="hidden" />
    <input asp-for="ModifiedAt" type="hidden" />

    <div class="form-group row mb-2">
        <label asp-for="Area" class="col-sm-2 col-form-label">Area (m²)</label>
        <div class="col-sm-10">
            <input asp-for="Area" class="form-control" />
        </div>
    </div>

    <div class="form-group row mb-2">
        <label asp-for="Location" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Location" class="form-control" />
        </div>
    </div>

    <div class="form-group row mb-2">
        <label asp-for="RoomNumber" class="col-sm-2 col-form-label">Room Number</label>
        <div class="col-sm-10">
            <input asp-for="RoomNumber" class="form-control" />
        </div>
    </div>

    <div class="form-group row mb-2">
        <label asp-for="BuildingType" class="col-sm-2 col-form-label">Building Type</label>
        <div class="col-sm-10">
            <input asp-for="BuildingType" class="form-control" />
        </div>
    </div>

    <div class="form-group row mb-2">
        <label asp-for="Files" class="control-label"></label>
        <input asp-for="Files" multiple type="file" class="form-control" />
    </div>

    <div>
        @foreach (var images in Model.Image)
        {
            <div class="d-inline-block me-2 mb-2 text-center">
                <partial name="_Images" model="images" />
                <br />
                <button type="submit" form="remove-image-form-@images.ImageId" class="mt-1 btn btn-danger btn-sm">
                    Remove Image
                </button>
            </div>
        }
    </div>
    
    <br />
    
    @if (Model.Id.HasValue)
    {
        <input type="submit" class="btn btn-success" value="Update" />
    }
    else
    {
        <input type="submit" class="btn btn-success" value="Create" />
    }

    <a asp-action="Index" asp-controller="realestate" class="btn btn-secondary">Back to List</a>
</form>
@foreach (var images in Model.Image)
{
    <form id="remove-image-form-@images.ImageId" asp-action="RemoveImage" asp-controller="RealEstate" method="post" style="display:none;">
        <input type="hidden" name="ImageId" value="@images.ImageId" />
    </form>
}
