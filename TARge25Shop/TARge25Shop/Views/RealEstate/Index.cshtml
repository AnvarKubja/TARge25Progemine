@model IEnumerable<TARge25Shop.Models.RealEstate.RealEstateIndexViewModel>

@{
    ViewData["Title"] = "Real Estates";
}

<div>
    <div class="page-title">
        <div>
            <h1>Real Estates</h1>
            <p>Kinnisvara kokku: @Model.Count()</p>
        </div>
        <a asp-action="create" asp-controller="realestate" class="btn btn-primary">
            Create
        </a>
    </div>

    <div class="card">
        @if (!Model.Any())
        {
            <div class="text-center text-muted p-5">
                <p class="mb-0">Kinnisvara pole veel lisatud.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Nr</th>
                            <th scope="col">Area (m²)</th>
                            <th scope="col">Location</th>
                            <th scope="col">Created At</th>
                            <th scope="col">Building Type</th>
                            <th scope="col">Rooms</th>
                            <th scope="col" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int nr = 1;
                        }
                        @foreach (var realestate in Model)
                        {
                            <tr>
                                <td class="text-muted">@nr</td>
                                <td>@realestate.Area</td>
                                <td class="fw-bold">@realestate.Location</td>
                                <td>@realestate.CreatedAt</td>
                                <td>@realestate.BuildingType</td>
                                <td>@realestate.RoomNumber</td>
                                <td class="actions">
                                    <a asp-action="details" asp-controller="realestate" asp-route-id="@realestate.Id" class="btn btn-sm btn-outline-secondary">
                                        Details
                                    </a>
                                    <a asp-action="update" asp-controller="realestate" asp-route-id="@realestate.Id" class="btn btn-sm btn-outline-secondary">
                                        Update
                                    </a>
                                    <a asp-action="delete" asp-controller="realestate" asp-route-id="@realestate.Id" class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                            nr++;
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
