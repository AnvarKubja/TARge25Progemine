@model IEnumerable<TARge25Shop.Models.RealEstate.RealEstateIndexViewModel>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-0">Real Estates</h1>
        </div>
        <a asp-action="create" asp-controller="realestate" class="btn btn-success px-4 py-2 shadow-sm">
            Create
        </a>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase small text-muted border-bottom">
                    <tr>
                        <th scope="col" class="ps-4" style="width: 60px;">Nr</th>
                        <th scope="col">Area (m²)</th>
                        <th scope="col">Location</th>
                        <th scope="col">Created At</th>
                        <th scope="col">Building Type</th>
                        <th scope="col">Rooms</th>
                        <th scope="col" class="text-end pe-4" style="width: 240px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int nr = 1;
                    }
                    @foreach (var realestate in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-muted">@nr</td>
                            <td>@realestate.Area</td>
                            <td>@realestate.Location</td>
                            <td>@realestate.CreatedAt</td>
                            <td>@realestate.BuildingType</td>
                            <td>@realestate.RoomNumber</td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="details" asp-controller="realestate" asp-route-id="@realestate.Id" class="btn btn-outline-secondary">
                                        Details
                                    </a>
                                    <a asp-action="update" asp-controller="realestate" asp-route-id="@realestate.Id" class="btn btn-outline-primary">
                                        Edit
                                    </a>
                                    <a asp-action="delete" asp-controller="realestate" asp-route-id="@realestate.Id" class="btn btn-outline-danger">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                        nr++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
