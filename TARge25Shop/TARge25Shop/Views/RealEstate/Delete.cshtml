@model TARge25Shop.Models.RealEstate.RealEstateDeleteViewModel

<link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
@{
    ViewData["Title"] = "Delete Real Estate?";
}

<div class="container mt-4">
    <h1 class="text-danger">Delete Real Estate</h1>
    <h3>Are you sure, you want to delete this Real Estate?</h3>
    <hr />

    <div class="card border-danger mb-4">
        <div class="card-header bg-danger text-white">
            <h4 class="card-title mb-0">Real Estate data</h4>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3 fw-bold">ID:</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3 fw-bold">Area (m²):</dt>
                <dd class="col-sm-9">@Model.Area</dd>

                <dt class="col-sm-3 fw-bold">Location:</dt>
                <dd class="col-sm-9">@Model.Location</dd>

                <dt class="col-sm-3 fw-bold">Room Number:</dt>
                <dd class="col-sm-9">@Model.RoomNumber</dd>
                
                <dt class="col-sm-3 fw-bold">Building Type:</dt>
                <dd class="col-sm-9">@Model.BuildingType</dd>
            </dl>
        </div>
    </div>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="Id" />
        
        <button type="submit" class="btn btn-danger me-2">
            <i class="bi bi-trash"></i> Yes, delete
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>
