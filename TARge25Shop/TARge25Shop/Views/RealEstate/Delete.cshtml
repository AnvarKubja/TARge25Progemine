@model TARge25Shop.Models.RealEstate.RealEstateDeleteViewModel

<link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
@{
    ViewData["Title"] = "Delete Real Estate?";
}

<div class="medium">
    <div class="page-title d-block">
        <h1>Kustuta kinnisvara</h1>
        <p>Kas oled kindel, et soovid selle kinnisvara kustutada?</p>
    </div>

    <div class="card mb-4">
        <div>
            <dl class="details">
                <dt>ID</dt>
                <dd>@Model.Id</dd>

                <dt>Area (m²)</dt>
                <dd>@Model.Area</dd>

                <dt>Location</dt>
                <dd>@Model.Location</dd>

                <dt>Room Number</dt>
                <dd>@Model.RoomNumber</dd>
                
                <dt>Building Type</dt>
                <dd>@Model.BuildingType</dd>

            </dl>
        </div>
    </div>

    <div class="images">
        @foreach (var images in Model.Image)
        {
            <partial name="_Images" model="images" />
        }
    </div>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="Id" />
        
        <button type="submit" class="btn btn-danger me-2">
            Jah, kustuta
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary">
            Tühista ja tagasi nimekirja
        </a>
    </form>
</div>
