@model TARge25Shop.Models.Kindergarten.KindergartenDeleteViewModel
<link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
@{
    ViewData["Title"] = "Delete kindergarten";
}

<div class="container mt-4">
    <h1 class="text-danger">Delete kindergarten</h1>
    <h3>Are you sure you want to delete this kindergarten?</h3>
    <hr />

    <div class="card border-danger mb-4">
        <div class="card-header bg-danger text-white">
            <h4 class="card-title mb-0">Kindergarten data</h4>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3 fw-bold">ID:</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3 fw-bold">Group Name:</dt>
                <dd class="col-sm-9">@Model.GroupName</dd>

                <dt class="col-sm-3 fw-bold">Children Count:</dt>
                <dd class="col-sm-9">@Model.ChildrenCount</dd>

                <dt class="col-sm-3 fw-bold">Kindergarten Name:</dt>
                <dd class="col-sm-9">@Model.KindergartenName</dd>
                
                <dt class="col-sm-3 fw-bold">Teacher Name:</dt>
                <dd class="col-sm-9">@Model.TeacherName</dd>
            </dl>
        </div>
    </div>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="Id" />
        
        <button type="submit" class="btn btn-danger me-2">
            <i class="bi bi-trash"></i> Yes, delete
        </button>
        <a asp-action="Index" class="btn btn-secondary">
            Cancel, back to the list
        </a>
    </form>
</div>
