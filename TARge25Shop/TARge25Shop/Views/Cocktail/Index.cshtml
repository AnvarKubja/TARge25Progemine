@model List<TARge25Shop.Core.Dto.CocktailRootDto>

@{
    ViewData["Title"] = "Cocktail Search";
}

<div class="d-flex flex-column align-items-center justify-content-center text-center my-5">
    <h1 class="mb-3">Kokteilide otsing</h1>
    <form asp-controller="Cocktail" asp-action="Search" method="get" class="w-100" style="max-width: 400px;">
        <div class="input-group">
            <input type="text" name="name" class="form-control" placeholder="Sisesta kokteili nimi..." value="@ViewBag.SearchName" required />
            <button class="btn btn-primary" type="submit">Otsi</button>
        </div>
    </form>
</div>

@if (ViewBag.Message != null)
{
    <div class="alert alert-info text-center mx-auto" style="max-width: 400px;">
        @ViewBag.Message
    </div>
}

<!-- Tulemused -->
@if (Model != null && Model.Count > 0)
{
    <div class="medium">
        @foreach (var drink in Model)
        {
            // Paneme koostisosad ja kogused ühte listi
            var ingredients = new[]
            {
                (Name: drink.Ingredient1, Amount: drink.Measure1),
                (Name: drink.Ingredient2, Amount: drink.Measure2),
                (Name: drink.Ingredient3, Amount: drink.Measure3),
                (Name: drink.Ingredient4, Amount: drink.Measure4),
                (Name: drink.Ingredient5, Amount: drink.Measure5),
                (Name: drink.Ingredient6, Amount: drink.Measure6),
                (Name: drink.Ingredient7, Amount: drink.Measure7),
                (Name: drink.Ingredient8, Amount: drink.Measure8),
                (Name: drink.Ingredient9, Amount: drink.Measure9),
                (Name: drink.Ingredient10, Amount: drink.Measure10),
                (Name: drink.Ingredient11, Amount: drink.Measure11),
                (Name: drink.Ingredient12, Amount: drink.Measure12),
                (Name: drink.Ingredient13, Amount: drink.Measure13),
                (Name: drink.Ingredient14, Amount: drink.Measure14),
                (Name: drink.Ingredient15, Amount: drink.Measure15),
            };

            <div class="card mb-4">
                <div class="dark-card cocktail-header">
                    @if (!string.IsNullOrWhiteSpace(drink.ImageUrl))
                    {
                        <img src="@drink.ImageUrl" alt="@drink.Name" />
                    }
                    <div>
                        <h2>@drink.Name</h2>
                        <span class="tag">@drink.Category</span>
                        <span class="tag">@drink.Alcoholic</span>
                        <span class="tag">@drink.Glass</span>
                    </div>
                </div>

                <h3 class="section-title">Koostisosad</h3>
                <dl class="details">
                    @foreach (var item in ingredients)
                    {
                        if (!string.IsNullOrWhiteSpace(item.Name))
                        {
                            <dt>@item.Amount</dt>
                            <dd>@item.Name</dd>
                        }
                    }
                </dl>

                <h3 class="section-title border-top">Valmistamine</h3>
                <p class="section-text">@(drink.Instructions ?? "Õpetus puudub.")</p>
            </div>
        }
    </div>
}
