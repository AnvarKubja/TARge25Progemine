@model TARge25Shop.Models.Account.ResetPasswordViewModel

@{
    ViewData["Title"] = "Password reset";
}

<h2>@ViewData["Title"]</h2>
<hr />

<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            
            @* Peidetud väljad on hädavajalikud, et Token ja Email jõuaksid POST päringuga tagasi kontrollerisse *@
            <input asp-for="Token" type="hidden" />
            <input asp-for="Email" type="hidden" />

            <div class="form-group mb-3">
                <label asp-for="Password" class="form-label">New password</label>
                <input asp-for="Password" class="form-control" type="password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ConfirmationPassword" class="form-label">Confirm new password</label>
                <input asp-for="ConfirmationPassword" class="form-control" type="password" />
                <span asp-validation-for="ConfirmationPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Reset password</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
