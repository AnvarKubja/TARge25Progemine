@model TARge25Shop.Models.Spaceship.SpaceshipCreateUpdateViewModel

<link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
<link rel="stylesheet" href="~/css/spaceship.css" asp-append-version="true" />

<div class="container mt-4">
    <div class="page-header">
        <h1>
            <i class="bi bi-rocket-takeoff"></i>
            @(Model.Id.HasValue ? "Update" : "Create")
        </h1>
        <p>@(Model.Id.HasValue ? "Muuda kosmoselaeva andmeid" : "Lisa uus kosmoselaev")</p>
    </div>

    <div class="card ship-card">
        <div class="card-body p-4">
            <form method="post" enctype="multipart/form-data" class="ship-form">
                <input asp-for="Id" type="hidden" />
                <input asp-for="CreatedAt" type="hidden" />
                <input asp-for="UpdatedAt" type="hidden" />

                <div class="row mb-3">
                    <label asp-for="Name" class="col-sm-2 col-form-label fw-bold"></label>
                    <div class="col-sm-10">
                        <input asp-for="Name" class="form-control" />
                    </div>
                </div>

                <div class="row mb-3">
                    <label asp-for="ShipType" class="col-sm-2 col-form-label fw-bold"></label>
                    <div class="col-sm-10">
                        <input asp-for="ShipType" class="form-control" />
                    </div>
                </div>

                <div class="row mb-3">
                    <label asp-for="Crew" class="col-sm-2 col-form-label fw-bold"></label>
                    <div class="col-sm-10">
                        <input asp-for="Crew" class="form-control" />
                    </div>
                </div>

                <div class="row mb-3">
                    <label asp-for="EnginePower" class="col-sm-2 col-form-label fw-bold"></label>
                    <div class="col-sm-10">
                        <input asp-for="EnginePower" class="form-control" />
                    </div>
                </div>

                <div class="row mb-3">
                    <label asp-for="Files" class="col-sm-2 col-form-label fw-bold"></label>
                    <div class="col-sm-10">
                        <input class="form-control" asp-for="Files" multiple type="file" />
                    </div>
                </div>

                @if (Model.Image.Any())
                {
                    <h5 class="mt-4 mb-3"><i class="bi bi-images"></i> Praegused pildid</h5>
                    <div class="row g-3 mb-4">
                        @foreach (var images in Model.Image)
                        {
                            <div class="col-6 col-md-4 col-lg-3">
                                <partial name="_Images" model="images" />
                                <input asp-action="removeImage" asp-controller="spaceship" asp-route-imageId="@images.ImageId" type="submit" class="btn btn-sm btn-outline-danger btn-pill w-100 mt-2" value="Remove Image" />
                            </div>
                        }
                    </div>
                }

                <hr />

                <div class="d-flex gap-2">
                    @if (Model.Id.HasValue)
                    {
                        <input asp-action="update" asp-controller="spaceship" type="submit" class="btn btn-space" value="Update" />
                    }
                    else
                    {
                        <input asp-action="create" asp-controller="spaceship" type="submit" class="btn btn-space" value="Create" />
                    }

                    <a asp-action="Index" asp-controller="spaceship" class="btn btn-outline-secondary btn-pill">Back to List</a>
                </div>
            </form>
        </div>
    </div>
</div>
