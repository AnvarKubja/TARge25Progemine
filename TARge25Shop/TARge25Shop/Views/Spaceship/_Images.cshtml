@model TARge25Shop.Models.Spaceship.ImageViewModel

@{
    var photoPaths = "~/multipleFileUpload/" + (Model.FilePath ?? "noimage.jpg");
}

<div class="card img-card">
    <img class="card-img-top" src="@photoPaths" asp-append-version="true" />
    <div class="card-body py-2">
        <small class="text-muted text-break">@Model.FilePath</small>
    </div>
</div>
