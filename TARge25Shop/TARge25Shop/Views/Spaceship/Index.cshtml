@model IEnumerable<TARge25Shop.Models.Spaceship.SpaceshipIndexViewModel>

<style>
    .space-header {
        background: linear-gradient(135deg, #0f172a, #4338ca);
        color: white;
        border-radius: 1rem;
        padding: 2rem;
    }

    .space-card {
        border: none;
        border-radius: 1rem;
        overflow: hidden;
    }

    .space-card thead th {
        background-color: #f1f5f9;
        color: #475569;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: none;
        padding: 1rem;
    }

    .space-card tbody td {
        padding: 1rem;
    }

    .space-card tbody tr:hover {
        background-color: #eef2ff;
    }

    .nr-circle {
        display: inline-block;
        width: 2rem;
        height: 2rem;
        line-height: 2rem;
        text-align: center;
        border-radius: 50%;
        background-color: #e0e7ff;
        color: #4338ca;
        font-weight: 600;
        font-size: 0.85rem;
    }
</style>

<div class="space-header shadow mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="h2 mb-1">Spaceships</h1>
        <p class="mb-0 opacity-75">Total ships: @Model.Count()</p>
    </div>
    <a asp-action="create" asp-controller="spaceship" class="btn btn-light btn-lg rounded-pill px-4">+ Create</a>
</div>

<div class="card space-card shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Nr</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Created at</th>
                    <th>Crew</th>
                    <th>Engine power</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int nr = 1;
                }
                @foreach (var spaceship in Model)
                {
                    <tr>
                        <td>@nr</td>
                        <td class="fw-semibold">@spaceship.Name</td>
                        <td><span class="badge rounded-pill bg-primary-subtle text-primary-emphasis px-3 py-2">@spaceship.ShipType</span></td>
                        <td class="text-muted">@spaceship.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@spaceship.Crew</td>
                        <td>@spaceship.EnginePower</td>
                        <td class="text-end">
                            <a asp-action="details" asp-controller="spaceship" asp-route-id="@spaceship.Id" class="btn btn-sm btn-outline-primary rounded-pill">Details</a>
                            <a asp-action="update" asp-controller="spaceship" asp-route-id="@spaceship.Id" class="btn btn-sm btn-outline-secondary rounded-pill">Update</a>
                            <a asp-action="delete" asp-controller="spaceship" asp-route-id="@spaceship.Id" class="btn btn-sm btn-outline-danger rounded-pill">Delete</a>
                        </td>
                    </tr>
                    nr++;
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <p class="mb-0">No spaceships yet.</p>
        </div>
    }
</div>