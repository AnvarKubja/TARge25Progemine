@model IEnumerable<TARge25Shop.Models.Spaceship.SpaceshipIndexViewModel>

<style>
    .space-card {
        border: none;
        border-radius: 1rem;
        overflow: hidden;
    }

    .space-card thead th {
        background-color: #f1f5f9;
        color: #475569;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: none;
        padding: 1rem;
    }

    .space-card tbody td {
        padding: 1rem;
    }

    .space-card tbody tr:hover {
        background-color: #eef2ff;
    }
</style>

<div class="d-flex justify-content-between align-items-center">
    <div>
        <h1>Spaceships</h1>
    </div>
    <div>
        <a asp-action="create" asp-controller="spaceship" class="btn btn-primary rounded-pill px-4 mb-3">+ Create</a>
    </div>
</div>


<div class="card space-card shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Nr</th>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Created at</th>
                    <th>Crew</th>
                    <th>Engine power</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int nr = 1;
                }
                @foreach (var spaceship in Model)
                {
                    <tr>
                        <td>@nr</td>
                        <td class="fw-semibold">@spaceship.Name</td>
                        <td><span class="badge rounded-pill bg-primary-subtle text-primary-emphasis px-3 py-2">@spaceship.ShipType</span></td>
                        <td class="text-muted">@spaceship.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@spaceship.Crew</td>
                        <td>@spaceship.EnginePower</td>
                        <td class="text-end">
                            <a asp-action="details" asp-controller="spaceship" asp-route-id="@spaceship.Id" class="btn btn-sm btn-outline-primary rounded-pill">Details</a>
                            <a asp-action="update" asp-controller="spaceship" asp-route-id="@spaceship.Id" class="btn btn-sm btn-outline-secondary rounded-pill">Update</a>
                            <a asp-action="delete" asp-controller="spaceship" asp-route-id="@spaceship.Id" class="btn btn-sm btn-outline-danger rounded-pill">Delete</a>
                        </td>
                    </tr>
                    nr++;
                }
            </tbody>
        </table>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <p class="mb-0">No spaceships yet.</p>
        </div>
    }
</div>